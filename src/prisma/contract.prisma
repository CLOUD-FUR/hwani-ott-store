// use prisma-8

model User {
  id            String   @id @default(uuid())
  userId        String   @unique // 5자리 회원 고유번호
  email         String   @unique
  name          String
  role          Role     @default(USER)
  googleId      String?  @unique
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  orders        Order[]
  logs          Log[]
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String
  price         Int
  image         String?
  isAvailable   Boolean  @default(true)
  options       Json?    // [{name: string, price: number}]
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  orders        Order[]
}

model Order {
  id            String   @id @default(uuid())
  orderNumber   String   @unique // 년도+월+일+회원ID+구매번호
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  selectedOption String?
  quantity      Int      @default(1)
  totalPrice    Int
  status        OrderStatus @default(PENDING)
  paymentMethod String?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  payment       Payment?
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  amount        Int
  status        PaymentStatus @default(PENDING)
  method        String
  transactionId String?
  paidAt        TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model Notice {
  id            String   @id @default(uuid())
  title         String
  content       String
  isActive      Boolean  @default(true)
  startDate     TimestamptzString?
  endDate       TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model Settings {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model Log {
  id            String   @id @default(uuid())
  type          LogType
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  email         String?
  action        String
  details       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     TimestamptzString @default(now())
}

enum Role {
  USER
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum LogType {
  access
  signup
  admin
  order
  payment
  product
  user
}
